  "cards": [
    {
      "dot": "rose",
      "title": "Two paths, not joined",
      "items": [
        "The rack overlay reads only telemetry_latest_status",
        "That table is written only by POST /telemetry/port-status/ingest",
        "Collector readings land in telemetry_reading, which the overlay never queries"
      ]
    },
    {
      "dot": "orange",
      "title": "Edge side is partial",
      "items": [
        "EdgeRuntime flushes the queue to /ingest, which carries discovery records",
        "snmp_metrics.py and telemetry_contract.py have no caller in the runtime",
        "telemetry_contract.py states the collector has no telemetry acquisition loop"
      ]
    },
    {
      "dot": "emerald",
      "title": "Working path",
      "items": [
        "A caller with telemetry:manage posts status for a binding",
        "The upsert keeps the newest sampled_at and ignores stale or duplicate samples",
        "The rack view refetches the latest status every 5 seconds"
      ]
    }
  ]
