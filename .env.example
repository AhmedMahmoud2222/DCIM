# Used by docker-compose.yml. Copy to .env and fill in real values before running
# `docker compose up` — compose will refuse to start if POSTGRES_PASSWORD or
# JWT_SECRET_KEY are unset (see the ${VAR:?message} references in docker-compose.yml).

POSTGRES_USER=dcim_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dcim

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS

ENVIRONMENT=development
