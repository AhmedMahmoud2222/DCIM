# Used by docker-compose.yml. Copy to .env and fill in real values before running
# `docker compose up` — compose will refuse to start if POSTGRES_PASSWORD,
# DCIM_APP_PASSWORD, or JWT_SECRET_KEY are unset (see the ${VAR:?message} references in
# docker-compose.yml).
#
# Two distinct passwords, two distinct roles (PHASE1_IMPLEMENTATION_RED_TEAM_REPORT.md
# Finding C1): POSTGRES_PASSWORD belongs to the Postgres bootstrap superuser (`postgres`)
# used only to initialize the cluster and to run scripts/bootstrap_privileged_roles.sql.
# DCIM_APP_PASSWORD belongs to `dcim_app`, the application's own ordinary, non-superuser
# database role — this is what the backend/migrate/celery services actually connect as.
# The two must never be the same value, and the application must never be given the
# superuser password.

POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER
DCIM_APP_PASSWORD=CHANGE_ME_APP
POSTGRES_DB=dcim

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS

ENVIRONMENT=development
