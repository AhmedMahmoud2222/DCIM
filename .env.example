# Used by docker-compose.yml. Copy to .env and fill in real values before running
# `docker compose up` — compose will refuse to start if POSTGRES_PASSWORD,
# DCIM_APP_PASSWORD, JWT_SECRET_KEY, or CREDENTIAL_ENCRYPTION_KEY are unset or empty (see the ${VAR:?message} references in
# docker-compose.yml).
#
# Two distinct passwords, two distinct roles (PHASE1_IMPLEMENTATION_RED_TEAM_REPORT.md
# Finding C1): POSTGRES_PASSWORD belongs to the Postgres bootstrap superuser (`postgres`)
# used only to initialize the cluster and to run scripts/bootstrap_privileged_roles.sql.
# DCIM_APP_PASSWORD belongs to `dcim_app`, the application's own ordinary, non-superuser
# database role — this is what the backend/migrate/celery services actually connect as.
# The two must never be the same value, and the application must never be given the
# superuser password.

POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER
DCIM_APP_PASSWORD=CHANGE_ME_APP
POSTGRES_DB=dcim

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS

# Generate ONCE per environment using the backend Python environment:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the output below in your untracked .env, not this example file.
# This is one shared Fernet key for migrate/backend/celery-worker/celery-beat.
# Preserve it across restarts and keep a protected recovery copy with database backups.
# Changing it without re-encrypting stored credentials makes them unreadable.
# See docs/OPERATIONS.md for rotation/recovery. Empty intentionally: no insecure default.
CREDENTIAL_ENCRYPTION_KEY=

ENVIRONMENT=development

# SEC-05: longer periods may be configured; shorter values fail validation.
# Applied by the hourly Celery maintenance task; heartbeat history older than 30
# days and signed-request nonces older than one hour are pruned in bounded batches.
NONCE_RETENTION_SECONDS=3600
HEARTBEAT_RETENTION_DAYS=30
