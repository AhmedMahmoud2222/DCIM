ENVIRONMENT=development

# Async URL for the FastAPI app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://dcim_app:CHANGE_ME@localhost:5432/dcim

REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS

# Phase 8: Integration credential-at-rest encryption key (app/core/secrets.py).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OPEN DECISION for production: migrate this key's storage to a real KMS/secrets
# manager rather than an env var — see PHASE8_EDGE_COLLECTOR_CONTRACT.md.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
